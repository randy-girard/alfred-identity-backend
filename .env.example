DATABASE_URL=postgres://alfred:alfred@localhost:5432/alfred_identity?sslmode=disable
HTTP_ADDR=0.0.0.0:8080
WS_PATH=/ws/sso
PROTOCOL_VERSION=1

# 32-byte key, base64-encoded (generate: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=

DISCORD_ENABLED=false
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
# Comma-separated Discord user snowflakes for first-run admins
DISCORD_BOOTSTRAP_ADMIN_IDS=
# Slash command name prefix (a-z, 0-9, -, _). Default alfred-identity-
DISCORD_COMMAND_PREFIX=alfred-identity-
# How often to refresh Discord roles for known users (guild members intent required)
DISCORD_ROLE_SYNC_SECONDS=300

# Discord-authenticated web admin (Accounts / Users / Sessions)
WEB_ENABLED=false
# Public origin used for OAuth redirect (no trailing slash), e.g. https://identity.example.com or http://127.0.0.1:8181
WEB_PUBLIC_URL=
# Role required to open the web UI (defaults to DISCORD_ADMIN_ROLE_ID)
WEB_ACCESS_ROLE_ID=
# Optional display name in /sso-source.json (defaults from hostname)
WEB_SSO_SOURCE_NAME=

PRESENCE_TTL_SECONDS=90
LOGIN_AUTH_RATE_LIMIT_PER_MIN=30
LOG_LEVEL=info
